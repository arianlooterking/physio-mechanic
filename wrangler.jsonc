{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "biomana",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "BIOMANA_KV",
      "id": "REPLACE_WITH_BIOMANA_KV_ID" // create with: npx wrangler kv namespace create BIOMANA_KV
    }
  ],
  // Public: the OAuth web client id for Google sign-in, and the Google accounts (comma-separated)
  // that may read content reports at /admin/reports. Secrets (SESSION_SECRET, ANTHROPIC_API_KEY)
  // are set with `wrangler secret put`, or in .dev.vars locally.
  // APPLE_SERVICES_ID switches Sign in with Apple on (worker/apple.ts): "com.biomana.web" once that Services ID
  // exists in the Apple Developer account with this site's domain and /api/apple-callback as its return URL.
  "vars": {
    "GOOGLE_CLIENT_ID": "",
    "ADMIN_EMAILS": "thearianasadi@gmail.com"
  }
}
