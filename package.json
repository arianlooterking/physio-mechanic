{
  "name": "biomana",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "بیومانا: یادگیری بازی‌وار درس‌های پایهٔ دوازدهم ریاضی با توضیح چندباره تا فهمیدن",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/app-bundle.mjs",
    "preview": "npm run build && wrangler dev",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "build:app": "npm run build && cap sync"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-updater": "^8.53.1",
    "katex": "0.19.0",
    "motion": "^12.43.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vazirmatn": "33.0.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fflate": "^0.8.3",
    "jsdom": "30.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "wrangler": "^4.151.0"
  }
