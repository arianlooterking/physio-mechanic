# Security and caching headers for the static site, applied by Cloudflare Workers static assets.
# Responses made by the Worker (/api/*) set their own headers in worker/lib.ts.
# If two rules set the same header, Cloudflare joins the values with a comma, so each header is set once.
#
# Content-Security-Policy, built from what the app really loads:
#   script-src   the app's own files (including /theme.js) + Google Identity Services (sign-in)
#   style-src    'unsafe-inline' for React style attributes, KaTeX and the boot screen in index.html; GIS stylesheet
#   img-src      own files, data: (CSS backgrounds), blob:, Google profile pictures
#   connect-src  /api/* on this site + GIS. A tutor on another address (meta biomana-ai-endpoint) must be added here.
#   frame-src    GIS button and One Tap iframes
# The Google URLs are the ones Google documents for GIS:
# https://developers.google.com/identity/gsi/web/guides/get-google-api-clientid#content_security_policy
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https://*.googleusercontent.com; font-src 'self'; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; worker-src 'self'; manifest-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), magnetometer=(), microphone=(), midi=(), payment=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Built files have a content hash in their name: cache them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The page and the service worker must always be checked for a new version.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/theme.js
  Cache-Control: no-cache

# The Android app download (kept out of the app bundle by scripts/app-bundle.mjs)
/app/biomana.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="biomana.apk"
  Cache-Control: no-cache

# What the installed apps check for a new version
/app-update/latest.json
  Cache-Control: no-cache
